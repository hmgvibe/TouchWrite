<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>TouchWrite</AssemblyName>
    <RootNamespace>TouchWrite</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- WFO0003: WinForms analyzer wants DPI set in code; this is a WPF app that sets it in app.manifest. -->
    <!-- WPF0001: the Fluent (Windows 11) theme used by the settings window is marked experimental in .NET 9. -->
    <NoWarn>$(NoWarn);WFO0003;WPF0001</NoWarn>
    <Version>1.0.0</Version>
    <Product>TouchWrite</Product>
    <Description>Trackpad handwriting input for Windows</Description>
  </PropertyGroup>

  <!-- The promo video tools have their own projects. -->
  <ItemGroup>
    <Compile Remove="promo\**" />
    <None Remove="promo\**" />
    <Page Remove="promo\**" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app-256.png" />
  </ItemGroup>

</Project>
