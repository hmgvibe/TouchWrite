<Window x:Class="TouchWrite.UI.TrayMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TouchWrite"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Left="-32000" Top="-32000"
        Width="304"
        SizeToContent="Height"
        UseLayoutRounding="True"
        FontFamily="Microsoft JhengHei UI, Segoe UI Variable Text, Segoe UI"
        FontSize="14">

    <Window.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- Plain menu row -->
        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="5" Padding="12,0" Height="38" Margin="0,1">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Big accent button: start handwriting -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="7"
                                Padding="14,0" Height="46">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Same size, neutral: stop handwriting -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="7"
                                BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                Padding="14,0" Height="46">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Margin="6">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="RootShift" />
        </Grid.RenderTransform>
        <StackPanel>
            <!-- Header -->
            <DockPanel Margin="10,10,10,14">
                <Image DockPanel.Dock="Left" Source="/Assets/app-256.png" Width="38" Height="38"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="TouchWrite" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText" FontSize="12" Margin="7,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <!-- Start / stop -->
            <Button x:Name="ToggleButton" Style="{StaticResource PrimaryButton}" Margin="4,0,4,8" Click="Toggle_Click">
                <DockPanel>
                    <TextBlock x:Name="ToggleGlyph" DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" Text="&#xEE56;"
                               FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Border DockPanel.Dock="Right" CornerRadius="4" Padding="7,2" VerticalAlignment="Center"
                            x:Name="HotkeyChip" Background="#26FFFFFF">
                        <TextBlock x:Name="HotkeyText" FontSize="11" FontFamily="Segoe UI Variable Text, Segoe UI" />
                    </Border>
                    <TextBlock x:Name="ToggleText" Text="開始手寫" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Button>

            <Border Height="1" Margin="-6,2,-6,4" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

            <Button Style="{StaticResource MenuButton}" Click="Settings_Click">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" Text="&#xE713;" FontSize="16"
                               Width="20" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <TextBlock Text="設定" VerticalAlignment="Center" />
                </DockPanel>
            </Button>
            <Button Style="{StaticResource MenuButton}" Click="Gestures_Click">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" Text="&#xE815;" FontSize="16"
                               Width="20" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <TextBlock Text="手勢說明" VerticalAlignment="Center" />
                </DockPanel>
            </Button>

            <Border Height="1" Margin="-6,4,-6,4" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

            <Button Style="{StaticResource MenuButton}" Click="Exit_Click" Margin="0,0,0,2">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" Text="&#xE7E8;" FontSize="16"
                               Width="20" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <TextBlock Text="結束 TouchWrite" VerticalAlignment="Center" />
                </DockPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
