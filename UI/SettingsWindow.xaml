<Window x:Class="TouchWrite.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TouchWrite 設定"
        Width="1000" Height="700"
        MinWidth="860" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/app.ico"
        FontFamily="Microsoft JhengHei UI, Segoe UI Variable Text, Segoe UI"
        FontSize="14"
        UseLayoutRounding="True">

    <Window.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <sys:String x:Key="ToggleOnText" xmlns:sys="clr-namespace:System;assembly=mscorlib">開</sys:String>
        <sys:String x:Key="ToggleOffText" xmlns:sys="clr-namespace:System;assembly=mscorlib">關</sys:String>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,24" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,24,0,8" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="MinHeight" Value="70" />
        </Style>

        <Style x:Key="CardIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Margin" Value="0,0,20,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="CardDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinWidth" Value="56" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,14,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <!-- Left navigation item -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Height="40" Margin="0,1" Background="Transparent">
                            <Border x:Name="Bg" CornerRadius="5" Background="Transparent" />
                            <Rectangle x:Name="Indicator" Width="3" Height="16" RadiusX="1.5" RadiusY="1.5"
                                       HorizontalAlignment="Left" Visibility="Collapsed"
                                       Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                            <ContentPresenter Margin="16,0,10,0" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows 11 style on/off switch -->
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <TextBlock x:Name="StateText" Text="{DynamicResource ToggleOffText}" VerticalAlignment="Center" Margin="0,0,12,0"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Grid Width="40" Height="20" VerticalAlignment="Center">
                                <Border x:Name="Track" CornerRadius="10" BorderThickness="1"
                                        BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                                        Background="{DynamicResource ControlAltFillColorSecondaryBrush}" />
                                <Ellipse x:Name="Thumb" Width="12" Height="12" HorizontalAlignment="Left" Margin="4,0,0,0"
                                         Fill="{DynamicResource TextFillColorSecondaryBrush}">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="ThumbShift" X="0" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbShift" Storyboard.TargetProperty="X"
                                                             To="20" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbShift" Storyboard.TargetProperty="X"
                                                             To="0" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                <Setter TargetName="StateText" Property="Text" Value="{DynamicResource ToggleOnText}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Thumb" Property="Width" Value="14" />
                                <Setter TargetName="Thumb" Property="Height" Value="14" />
                                <Setter TargetName="Thumb" Property="Margin" Value="3,0,0,0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="272" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================== Navigation ============================== -->
        <DockPanel Margin="12,14,8,14">
            <Grid DockPanel.Dock="Top" Margin="10,6,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Source="/Assets/app-256.png" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="TouchWrite" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="觸控板手寫輸入" FontSize="12" Margin="0,1,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0" Padding="0"
                     ItemContainerStyle="{StaticResource NavItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="Nav_SelectionChanged">
                <ListBoxItem Tag="General">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE713;" FontSize="16" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="一般" Margin="14,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="Handwriting">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xEE56;" FontSize="16" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="手寫辨識" Margin="14,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="Gestures">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE815;" FontSize="16" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="手勢與按鍵" Margin="14,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="About">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE946;" FontSize="16" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="關於" Margin="14,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </ListBoxItem>
            </ListBox>
        </DockPanel>

        <!-- ============================== Pages ============================== -->
        <ScrollViewer x:Name="PageScroller" Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <Grid Margin="28,26,40,32" MaxWidth="1000" HorizontalAlignment="Stretch">

                <!-- ========== General ========== -->
                <StackPanel x:Name="PageGeneral">
                    <TextBlock Style="{StaticResource PageTitle}" Text="一般" />

                    <!-- Status -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Padding="18,16">
                            <DockPanel>
                                <Grid DockPanel.Dock="Left" Width="44" Height="44" Margin="0,0,16,0">
                                    <Border x:Name="TouchpadBadge" CornerRadius="22" />
                                    <TextBlock x:Name="TouchpadGlyph" FontFamily="{StaticResource IconFont}" FontSize="20"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="觸控板" FontWeight="SemiBold" />
                                    <TextBlock x:Name="TouchpadStatus" Style="{StaticResource CardDesc}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,16">
                            <DockPanel>
                                <Grid DockPanel.Dock="Left" Width="44" Height="44" Margin="0,0,16,0">
                                    <Border x:Name="RecognizerBadge" CornerRadius="22" />
                                    <TextBlock x:Name="RecognizerGlyph" FontFamily="{StaticResource IconFont}" FontSize="20"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="手寫辨識" FontWeight="SemiBold" />
                                    <TextBlock x:Name="RecognizerStatus" Style="{StaticResource CardDesc}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <TextBlock Style="{StaticResource SectionHeader}" Text="啟動" />

                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock Style="{StaticResource CardIcon}" Text="&#xE765;" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Click, then press the new key combination -->
                                <Button x:Name="HotkeyRecorder" MinWidth="230" Height="38" Padding="10,0"
                                        HorizontalContentAlignment="Center" Click="HotkeyRecorder_Click"
                                        LostKeyboardFocus="HotkeyRecorder_LostFocus">
                                    <StackPanel x:Name="HotkeyKeys" Orientation="Horizontal" />
                                </Button>
                                <Button x:Name="HotkeyReset" Margin="8,0,0,0" Height="38" Width="38" Padding="0"
                                        Click="HotkeyReset_Click" ToolTip="還原預設">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7A7;" FontSize="14" />
                                </Button>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource CardTitle}" Text="快捷鍵" />
                                <TextBlock x:Name="HotkeyDesc" Style="{StaticResource CardDesc}" Text="點右邊的按鈕，再按下新的組合鍵即可更換" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border x:Name="HotkeyWarning" Visibility="Collapsed" CornerRadius="7" Padding="16,10" Margin="0,0,0,4"
                            Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7BA;" FontSize="16" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                            <TextBlock x:Name="HotkeyWarningText" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock Style="{StaticResource CardIcon}" Text="&#xE7E8;" />
                            <CheckBox x:Name="StartupBox" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"
                                      VerticalAlignment="Center" Click="StartupBox_Click" />
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource CardTitle}" Text="登入 Windows 時自動啟動" />
                                <TextBlock Style="{StaticResource CardDesc}" Text="TouchWrite 會在系統匣待命，隨時可以手寫" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionHeader}" Text="語言" />
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock Style="{StaticResource CardIcon}" Text="&#xE775;" />
                            <ComboBox x:Name="LanguageBox" DockPanel.Dock="Right" Width="220" VerticalAlignment="Center"
                                      SelectionChanged="AnySetting_Changed">
                                <ComboBoxItem x:Name="LanguageAutoItem" Content="跟隨系統" />
                                <ComboBoxItem Content="繁體中文" Tag="NoLoc" />
                                <ComboBoxItem Content="简体中文" Tag="NoLoc" />
                            </ComboBox>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource CardTitle}" Text="介面語言" />
                                <TextBlock Style="{StaticResource CardDesc}" Text="設定視窗、手寫面板與系統匣選單使用的文字" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionHeader}" Text="快速上手" />
                    <Border Style="{StaticResource Card}" Padding="20,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="1" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Style="{StaticResource CardTitle}" Margin="0,6,0,0">
                                    <Run Text="按" /> <Run x:Name="QuickHotkey" FontWeight="SemiBold" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource CardDesc}" Text="觸控板變成手寫板" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                <TextBlock Text="2" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Style="{StaticResource CardTitle}" Margin="0,6,0,0" Text="用一根手指寫字" />
                                <TextBlock Style="{StaticResource CardDesc}" Text="停筆自動輸入，或點選候選字" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="3" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Style="{StaticResource CardTitle}" Margin="0,6,0,0" Text="按 Esc 結束" />
                                <TextBlock Style="{StaticResource CardDesc}" Text="滑鼠立即恢復" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ========== Handwriting ========== -->
                <StackPanel x:Name="PageHandwriting" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="手寫辨識" />

                    <Border Style="{StaticResource Card}" CornerRadius="7,7,0,0" Margin="0">
                        <DockPanel>
                            <TextBlock Style="{StaticResource CardIcon}" Text="&#xE8C1;" />
                            <ComboBox x:Name="RecognizerBox" DockPanel.Dock="Right" Width="280" VerticalAlignment="Center"
                                      SelectionChanged="AnySetting_Changed" />
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource CardTitle}" Text="辨識引擎" />
                                <TextBlock Style="{StaticResource CardDesc}" Text="使用 Windows 語言套件內建的手寫辨識" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" CornerRadius="0,0,7,7" BorderThickness="1,0,1,1" MinHeight="0"
                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Padding="60,14,18,14">
                        <DockPanel>
                            <Button x:Name="OpenLanguageSettings" DockPanel.Dock="Right" VerticalAlignment="Center"
                                    Click="OpenLanguageSettings_Click" Padding="14,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="開啟語言設定" />
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8A7;" FontSize="12"
                                               Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="RecognizerHelp" Style="{StaticResource CardDesc}" Margin="0,0,20,0" VerticalAlignment="Center"
                                       Text="想加入其他語言的辨識？在「語言與地區」中新增或選擇該語言 → 語言選項 → 安裝「手寫」。" />
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,4,0,4">
                        <DockPanel>
                            <TextBlock Style="{StaticResource CardIcon}" Text="&#xE8AB;" />
                            <ComboBox x:Name="ScriptBox" DockPanel.Dock="Right" Width="220" VerticalAlignment="Center"
                                      SelectionChanged="AnySetting_Changed">
                                <ComboBoxItem Content="與辨識結果相同" />
                                <ComboBoxItem Content="一律轉為繁體" />
                                <ComboBoxItem Content="一律轉為簡體" />
                            </ComboBox>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource CardTitle}" Text="輸出字形" />
                                <TextBlock Style="{StaticResource CardDesc}" Text="把候選字轉換成繁體或簡體後再輸入" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionHeader}" Text="書寫" />

                    <Border Style="{StaticResource Card}" CornerRadius="7,7,0,0" Margin="0">
                        <DockPanel>
                            <TextBlock Style="{StaticResource CardIcon}" Text="&#xE916;" />
                            <CheckBox x:Name="AutoCommitBox" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"
                                      VerticalAlignment="Center" Click="AutoCommitBox_Click" />
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource CardTitle}" Text="停筆後自動輸入" />
                                <TextBlock x:Name="AutoCommitDesc" Style="{StaticResource CardDesc}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border x:Name="DelayRow" Style="{StaticResource Card}" CornerRadius="0,0,7,7" BorderThickness="1,0,1,1"
                            MinHeight="0" Padding="60,12,18,12"
                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="DelayText" Style="{StaticResource ValueText}" />
                                <Slider x:Name="DelaySlider" Width="220" Minimum="300" Maximum="2000" TickFrequency="100"
                                        IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                        ValueChanged="AnySlider_Changed" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="等待時間" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" CornerRadius="7,7,0,0" Margin="0,4,0,0">
                        <DockPanel>
                            <TextBlock Style="{StaticResource CardIcon}" Text="&#xE740;" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="WidthText" Style="{StaticResource ValueText}" />
                                <Slider x:Name="WidthSlider" Width="220" Minimum="400" Maximum="900" TickFrequency="20"
                                        IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                        ValueChanged="AnySlider_Changed" />
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource CardTitle}" Text="手寫面板大小" />
                                <TextBlock Style="{StaticResource CardDesc}" Text="螢幕下方顯示的手寫面板寬度" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <!-- Live size preview: a miniature screen with the panel drawn to scale -->
                    <Border Style="{StaticResource Card}" CornerRadius="0,0,7,7" BorderThickness="1,0,1,1"
                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Padding="18,18">
                        <Border x:Name="ScreenMock" Width="320" Height="180" CornerRadius="8" BorderThickness="1"
                                HorizontalAlignment="Center"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                            <Grid>
                                <TextBlock Text="螢幕" FontSize="11" Margin="10,8" HorizontalAlignment="Left" VerticalAlignment="Top"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <Border x:Name="PanelMock" CornerRadius="5" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                        Margin="0,0,0,8" Background="#E62A2A2E" BorderBrush="#40FFFFFF" BorderThickness="1">
                                    <Border x:Name="PadMock" Margin="4,8,4,4" CornerRadius="3" Background="#1FFFFFFF">
                                        <Border VerticalAlignment="Top" Height="1" Margin="0,8,0,0" Background="#33FFFFFF" />
                                    </Border>
                                </Border>
                            </Grid>
                        </Border>
                    </Border>
                </StackPanel>

                <!-- ========== Gestures ========== -->
                <StackPanel x:Name="PageGestures" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="手勢與按鍵" Margin="0,0,0,8" />
                    <TextBlock Style="{StaticResource CardDesc}" FontSize="13" Margin="0,0,0,20"
                               Text="手寫時，整個觸控板就是書寫板，螢幕上的手寫面板與觸控板的位置一一對應。" />

                    <UniformGrid x:Name="GestureGrid" Columns="3" Margin="-4,0" />

                    <TextBlock Style="{StaticResource SectionHeader}" Text="鍵盤" />
                    <StackPanel x:Name="KeyList" />
                </StackPanel>

                <!-- ========== About ========== -->
                <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="關於" />

                    <Border Style="{StaticResource Card}" Padding="24,22">
                        <DockPanel>
                            <Image DockPanel.Dock="Left" Source="/Assets/app-256.png" Width="72" Height="72" Margin="0,0,22,0"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="TouchWrite" FontSize="22" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock x:Name="VersionText" Style="{StaticResource CardDesc}" FontSize="13" />
                                <TextBlock Style="{StaticResource CardDesc}" FontSize="13" Margin="0,8,0,0"
                                           Text="在 Windows 上重現 Mac 的觸控板手寫輸入。讀取精確式觸控板的手指位置，交給 Windows 內建的手寫辨識，再把文字輸入到目前的程式。" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionHeader}" Text="資料" />
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock Style="{StaticResource CardIcon}" Text="&#xE8B7;" />
                            <Button DockPanel.Dock="Right" VerticalAlignment="Center" Padding="14,6" Content="開啟資料夾"
                                    Click="OpenSettingsFolder_Click" />
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource CardTitle}" Text="設定檔" />
                                <TextBlock x:Name="SettingsPathText" Style="{StaticResource CardDesc}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionHeader}" Text="使用須知" />
                    <Border Style="{StaticResource Card}" Padding="20,16">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardDesc}" FontSize="13" Margin="0"
                                       Text="• 需要 Windows 精確式觸控板（Precision Touchpad）。" />
                            <TextBlock Style="{StaticResource CardDesc}" FontSize="13" Margin="0,6,0,0"
                                       Text="• 手寫時所有滑鼠（包括外接滑鼠）都會暫停，結束手寫後立即恢復。" />
                            <TextBlock Style="{StaticResource CardDesc}" FontSize="13" Margin="0,6,0,0"
                                       Text="• 若要在「以系統管理員身分執行」的程式中手寫，TouchWrite 也需要以系統管理員身分執行。" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
